    %vpi_call/w 3 10 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x555564df2770 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x555565159280_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x555565158ec0_0, 0, 1;
    %wait E_0x555563c65dd0;
    %delay 1000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x555565159280_0, 0, 1;
    %pushi/vec4 1, 0, 32;
    %store/vec4 v0x5555651591e0_0, 0, 32;
T_2.0 ; Top of for-loop
    %load/vec4 v0x5555651591e0_0;
    %cmpi/s 125, 0, 32;
	  %jmp/0xz T_2.1, 5;
    %load/vec4 v0x555565158f60_0;
    %load/vec4 v0x5555651591e0_0;
    %part/s 1;
    %store/vec4 v0x555565158ec0_0, 0, 1;
    %wait E_0x555563c65dd0;
    %delay 1000, 0;
    %load/vec4 v0x555565159320_0;
    %cmpi/e 1, 0, 1;
    %jmp/0xz  T_2.3, 6;
    %vpi_call/w 3 16 "$display", "SUCCESS=1 at cycle %0d", v0x5555651591e0_0 {0 0 0};
T_2.3 ;
T_2.2 ; for-loop step statement
    %load/vec4 v0x5555651591e0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5555651591e0_0, 0, 32;
    %jmp T_2.0;
T_2.1 ; for-loop exit label
    %pushi/vec4 20, 0, 32;
T_2.5 %dup/vec4;
    %cmpi/s 0, 0, 32;
    %jmp/1xz T_2.6, 5;
    %jmp/1 T_2.6, 4;
    %subi 1, 0, 32;
    %wait E_0x555563c65dd0;
    %jmp T_2.5;
T_2.6 ;
    %pop/vec4 1;
    %vpi_call/w 3 19 "$display", "final success=%b", v0x555565159320_0 {0 0 0};
    %vpi_call/w 3 20 "$finish" {0 0 0};
    %end;
